{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "customCss": ["/styles/custom.css"],
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development",
              "webhooks"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          },
          {
            "group": "Authentication",
            "openapi": "/api-reference/authentication.json",
            "pages": [
              "POST /oauth/token"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/api-reference/endpoints_openapi.json",
            "pages": [
              "GET /senders",
              "GET /teams",
              "GET /templates",
              "GET /template/{templateUuid}",
              "GET /signrequests",
              "GET /signrequest/{signrequestUuid}",
              "GET /signrequest/weblink/participant/{participantUuid}",
              "GET /signrequest/embed/participant/{participantUuid}",
              "POST /signrequest/send/template/{templateUuid}",
              "POST /signrequest/{signrequestUuid}/cancel",
              "POST /signrequest/complete/participant/{participantUuid}",
              "POST /signrequest/{signrequestUuid}/download",
              "POST /files/signrequest/{signrequestUuid}/download",
              "POST /signrequest/file/{fileUuid}/download",
              "POST /signrequest/{signrequestUuid}/audit_trail/download"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Guides",
        "href": "/index"
      },
      {
        "label": "API Reference",
        "href": "/api-reference/introduction"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
